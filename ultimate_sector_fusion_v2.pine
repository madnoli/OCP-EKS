//@version=6
// ══════════════════════════════════════════════════════════════════════════════
//  ULTIMATE SECTOR FUSION — Perfect Stock Detector [NSE F&O]  v2 (Accuracy Patch)
//
//  FIXES IN THIS VERSION:
//   1. POC now uses ta.highestbars() — no fragile float equality, no stale var
//   2. Sector & stock ROC anchored to true "D" session open (repaint-safe)
//   3. Session-settle gate — skips first 3 bars where ROC clusters at 0% (rank noise)
//   4. Rank tiebreaker on identical ROC values
//   5. Alert vote strings corrected to /6 (was /5)
//
//  request.security calls: 19 close + 19 daily-open + 1 HTF EMA = 39 (within 40)
//
//  ALERT BEHAVIOR: alert() fires ONLY on bar close (finalBuy/finalSell already
//  carry barstate.isconfirmed). Set alert frequency to "Once Per Bar Close".
// ══════════════════════════════════════════════════════════════════════════════
indicator("Ultimate Sector Fusion Perfect Stock v2", overlay=true,
     max_labels_count=500, max_boxes_count=200)

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 1 — INPUTS
// ══════════════════════════════════════════════════════════════════════════════

grp_sec   = "🏭 Sector Settings"
topN      = input.int(6, "Top N Sectors for BUY",  minval=1, maxval=19, group=grp_sec)
botN      = input.int(6, "Bot N Sectors for SELL", minval=1, maxval=19, group=grp_sec)

grp_adx   = "📈 ADX & Direction"
adx_len   = input.int(14,   "ADX Length",             minval=1,  group=grp_adx)
adx_thresh= input.float(25, "ADX Threshold",          minval=1,  group=grp_adx)
lookback  = input.int(5,    "Price Direction Lookback",minval=1, group=grp_adx)

grp_vol   = "📦 Volume Intelligence"
vol_sma_len   = input.int(50,    "Signal Vol SMA Period",    minval=1,  group=grp_vol)
vol_sma_mult  = input.float(2.5, "Signal Vol Multiplier (x)",minval=0.5,group=grp_vol)
vol_cap       = input.float(40.0,"Anti-Spike Vol Cap (x SMA)",minval=5,  group=grp_vol)
vol_z_thresh  = input.float(1.5, "Volume Z-Score Threshold", minval=0.5,group=grp_vol)

grp_trend = "📐 Trend Filters"
use_htf   = input.bool(true,  "Filter with HTF EMA 200",  group=grp_trend)
htf_tf    = input.timeframe("240","HTF Timeframe",         group=grp_trend)
use_st    = input.bool(true,  "Use SuperTrend Filter",     group=grp_trend)
st_factor = input.float(3.0,  "SuperTrend Factor",step=0.1,group=grp_trend)
st_atr_len= input.int(10,     "SuperTrend ATR Length",     group=grp_trend)

grp_safe  = "🛡️ Quality & Safety"
min_body  = input.float(0.35, "Min Candle Body Ratio",    minval=0.1,maxval=1.0,group=grp_safe)
max_body_atr = input.float(3.5,"Max Body (x ATR)",        minval=1.0,group=grp_safe)
breakout_len = input.int(8,   "Breakout Lookback (days)", minval=2,  group=grp_safe)

grp_vote  = "🎯 Master Voting"
min_votes = input.int(3,      "Min Engines to Agree",     minval=1, maxval=6, group=grp_vote)
settle_bars = input.int(3,    "Skip first N bars of session", minval=0, maxval=20, group=grp_vote)

grp_orb   = "🕘️ Opening Range Breakout"
use_orb   = input.bool(true,  "Enable ORB Filter",        group=grp_orb)
orb_sess  = input.session("0915-0930","ORB Session",       group=grp_orb)

grp_div   = "🔀 Divergence Detection"
use_div   = input.bool(true,  "Enable Divergence Boost",  group=grp_div)
div_len   = input.int(5,      "Divergence Lookback Bars", minval=3, maxval=20, group=grp_div)

grp_rr    = "🎯 Risk / Reward"
rr_atr_sl = input.float(1.5,  "Stop Loss (x ATR)",        minval=0.5, step=0.1, group=grp_rr)
rr_ratio  = input.float(2.0,  "Target R:R Ratio",         minval=1.0, step=0.1, group=grp_rr)

grp_vwap  = "📏 VWAP Bands"
show_vwap_bands = input.bool(true, "Show VWAP Bands",     group=grp_vwap)
vwap_mult1 = input.float(1.0, "Band 1 Multiplier",        minval=0.1, step=0.1, group=grp_vwap)
vwap_mult2 = input.float(2.0, "Band 2 Multiplier",        minval=0.1, step=0.1, group=grp_vwap)

grp_dash  = "📊 Dashboard"
showDash  = input.bool(true,  "Show Dashboard",           group=grp_dash)
dashPos   = input.string("Bottom Right","Position",
     options=["Top Right","Bottom Right","Top Left","Bottom Left"], group=grp_dash)

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 2 — HELPER FUNCTIONS
// ══════════════════════════════════════════════════════════════════════════════

_match(haystack, needle) =>
    str.contains("," + haystack + ",", "," + needle + ",")

f_zscore(src, len) =>
    (src - ta.sma(src, len)) / math.max(ta.stdev(src, len), 1e-10)

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 3 — FULL 19-SECTOR STOCK LISTS (All NSE F&O Stocks)
// ══════════════════════════════════════════════════════════════════════════════

s_psu_bank = "SBIN,PNB,BANKBARODA,CANBK,UNIONBANK,BANKINDIA,INDIANB"
s_pvt_bank = "HDFCBANK,ICICIBANK,KOTAKBANK,AXISBANK,INDUSINDBK,IDFCFIRSTB,FEDERALBNK,AUBANK,BANDHANBNK,RBLBANK,YESBANK"
s_finance  = "BAJFINANCE,BAJAJFINSV,SHRIRAMFIN,CHOLAFIN,RECLTD,PFC,HDFCLIFE,SBILIFE,ICICIPRULI,SBICARD,MUTHOOTFIN,MANAPPURAM,JIOFIN,ABCAPITAL,BAJAJHLDNG,SAMMAANCAP,PNBHOUSING,LICHSGFIN,LTF,LICI,MFSL,ICICIGI"
s_cap_mkt  = "BSE,HDFCAMC,MCX,NAM-INDIA,MOTILALOFS,360ONE,CDSL,ANGELONE,NUVAMA,CAMS,KFINTECH"
s_fmcg     = "ITC,HINDUNILVR,NESTLEIND,BRITANNIA,TATACONSUM,DABUR,GODREJCP,MARICO,COLPAL,PATANJALI,UNITDSPR,VBL,GODFRYPHLP,VMM"
s_it       = "TCS,INFY,HCLTECH,WIPRO,TECHM,LTM,PERSISTENT,COFORGE,MPHASIS,KPITTECH,TATATECH,OFSS,TATAELXSI,NAUKRI,PAYTM,POLICYBZR"
s_auto     = "MARUTI,M&M,BAJAJ-AUTO,EICHERMOT,HEROMOTOCO,TVSMOTOR,ASHOKLEY,BHARATFORG,MOTHERSON,BOSCHLTD,SONACOMS,EXIDEIND,TIINDIA,UNOMINDA,TMPV,HYUNDAI,FORCEMOT"
s_pharma   = "SUNPHARMA,CIPLA,DRREDDY,DIVISLAB,LUPIN,ALKEM,AUROPHARMA,TORNTPHARM,ZYDUSLIFE,MANKIND,BIOCON,GLENMARK,LAURUSLABS,PPLPHARMA"
s_health   = "APOLLOHOSP,MAXHEALTH,FORTIS"
s_metal    = "TATASTEEL,HINDALCO,JSWSTEEL,VEDL,JINDALSTEL,HINDZINC,SAIL,NATIONALUM,NMDC,COALINDIA,APLAPOLLO"
s_power    = "NTPC,POWERGRID,TATAPOWER,ADANIGREEN,ADANIENSOL,ADANIPOWER,JSWENERGY,NHPC,SUZLON,INOXWIND,TORNTPOWER,IREDA,WAAREEENER,PREMIERENE,IEX"
s_oil_gas  = "RELIANCE,ONGC,OIL,GAIL,BPCL,IOC,HINDPETRO,PETRONET"
s_infra    = "LT,ABB,SIEMENS,CUMMINSIND,CGPOWER,ASTRAL,POLYCAB,KEI,GMRAIRPORT,ADANIPORTS,BHARTIARTL,IDEA,INDUSTOWER,SUPREMEIND,POWERINDIA,BHEL,CONCOR"
s_defence  = "HAL,BEL,MAZDOCK,BDL,SOLARINDS,COCHINSHIP,RVNL,IRFC,HUDCO"
s_realty   = "DLF,GODREJPROP,OBEROIRLTY,PHOENIXLTD,PRESTIGE,LODHA,NBCC"
s_chem     = "PIDILITIND,SRF,UPL,PIIND"
s_commod   = "GRASIM,ULTRACEMCO,AMBUJACEM,SHREECEM,DALBHARAT"
s_consume  = "TITAN,HAVELLS,DIXON,KALYANKJIL,VOLTAS,BLUESTARCO,AMBER,PGEL,CROMPTON,ASIANPAINT,KAYNES"
s_conssvc  = "TRENT,JUBLFOOD,DMART,INDHOTEL,ETERNAL,SWIGGY,NYKAA,DELHIVERY,PAGEIND,INDIGO"

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 4 — STOCK → SECTOR MAPPING (Full 19 Sectors)
// ══════════════════════════════════════════════════════════════════════════════

t = syminfo.ticker

[my_sector, sector_name] = switch
    _match(s_psu_bank, t) => ["NSE:NIFTY_PSU_BANK",     "PSU Bank"]
    _match(s_pvt_bank, t) => ["NSE:NIFTY_PVT_BANK",     "Pvt Bank"]
    _match(s_finance,  t) => ["NSE:NIFTY_FIN_SERVICE",  "Finance"]
    _match(s_cap_mkt,  t) => ["NSE:NIFTY_CAPITAL_MKT",  "Cap Markets"]
    _match(s_fmcg,     t) => ["NSE:NIFTY_FMCG",         "FMCG"]
    _match(s_it,       t) => ["NSE:NIFTY_IT",           "IT"]
    _match(s_auto,     t) => ["NSE:NIFTY_AUTO",         "Auto"]
    _match(s_pharma,   t) => ["NSE:NIFTY_PHARMA",       "Pharma"]
    _match(s_health,   t) => ["NSE:NIFTY_HEALTHCARE",   "Healthcare"]
    _match(s_metal,    t) => ["NSE:NIFTY_METAL",        "Metal"]
    _match(s_power,    t) => ["NSE:NIFTY_ENERGY",       "Power/Energy"]
    _match(s_oil_gas,  t) => ["NSE:NIFTY_OIL_AND_GAS",  "Oil & Gas"]
    _match(s_infra,    t) => ["NSE:NIFTY_INFRA",        "Infra"]
    _match(s_defence,  t) => ["NSE:NIFTY_PSE",          "Defence/PSE"]
    _match(s_realty,   t) => ["NSE:NIFTY_REALTY",       "Realty"]
    _match(s_chem,     t) => ["NSE:NIFTY_CHEMICALS",    "Chemicals"]
    _match(s_commod,   t) => ["NSE:NIFTY_COMMODITIES",  "Commodities"]
    _match(s_consume,  t) => ["NSE:NIFTY_CONSR_DURBL",  "Consumer Dur"]
    _match(s_conssvc,  t) => ["NSE:CNXCONSUMPTION",     "Consumer Svc"]
    => ["NSE:NIFTY_50", "⚠️ Unlisted"]

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 5 — LIVE 19-SECTOR RANKING
//
//  FIX #2: ROC now anchored to TRUE "D" session open (not nested valuewhen).
//  Fetches sector close on current TF + sector open on "D" TF, both lookahead_off.
//  This is repaint-safe and matches live intraday value at every bar.
// ══════════════════════════════════════════════════════════════════════════════

f_roc(simple string sym) =>
    float c = request.security(sym, timeframe.period, close, lookahead=barmerge.lookahead_off)
    float o = request.security(sym, "D", open, lookahead=barmerge.lookahead_off)
    o != 0 ? (c - o) / o * 100.0 : 0.0

roc_00 = f_roc("NSE:NIFTY_PSU_BANK")
roc_01 = f_roc("NSE:NIFTY_PVT_BANK")
roc_02 = f_roc("NSE:NIFTY_FIN_SERVICE")
roc_03 = f_roc("NSE:NIFTY_CAPITAL_MKT")
roc_04 = f_roc("NSE:NIFTY_FMCG")
roc_05 = f_roc("NSE:NIFTY_IT")
roc_06 = f_roc("NSE:NIFTY_AUTO")
roc_07 = f_roc("NSE:NIFTY_PHARMA")
roc_08 = f_roc("NSE:NIFTY_HEALTHCARE")
roc_09 = f_roc("NSE:NIFTY_METAL")
roc_10 = f_roc("NSE:NIFTY_ENERGY")
roc_11 = f_roc("NSE:NIFTY_OIL_AND_GAS")
roc_12 = f_roc("NSE:NIFTY_INFRA")
roc_13 = f_roc("NSE:NIFTY_PSE")
roc_14 = f_roc("NSE:NIFTY_REALTY")
roc_15 = f_roc("NSE:NIFTY_CHEMICALS")
roc_16 = f_roc("NSE:NIFTY_COMMODITIES")
roc_17 = f_roc("NSE:NIFTY_CONSR_DURBL")
roc_18 = f_roc("NSE:CNXCONSUMPTION")

my_sector_idx = my_sector == "NSE:NIFTY_PSU_BANK" ? 0 : my_sector == "NSE:NIFTY_PVT_BANK" ? 1 :
     my_sector == "NSE:NIFTY_FIN_SERVICE" ? 2 : my_sector == "NSE:NIFTY_CAPITAL_MKT" ? 3 :
     my_sector == "NSE:NIFTY_FMCG" ? 4 : my_sector == "NSE:NIFTY_IT" ? 5 :
     my_sector == "NSE:NIFTY_AUTO" ? 6 : my_sector == "NSE:NIFTY_PHARMA" ? 7 :
     my_sector == "NSE:NIFTY_HEALTHCARE" ? 8 : my_sector == "NSE:NIFTY_METAL" ? 9 :
     my_sector == "NSE:NIFTY_ENERGY" ? 10 : my_sector == "NSE:NIFTY_OIL_AND_GAS" ? 11 :
     my_sector == "NSE:NIFTY_INFRA" ? 12 : my_sector == "NSE:NIFTY_PSE" ? 13 :
     my_sector == "NSE:NIFTY_REALTY" ? 14 : my_sector == "NSE:NIFTY_CHEMICALS" ? 15 :
     my_sector == "NSE:NIFTY_COMMODITIES" ? 16 : my_sector == "NSE:NIFTY_CONSR_DURBL" ? 17 :
     my_sector == "NSE:CNXCONSUMPTION" ? 18 : -1

my_roc = my_sector_idx == 0 ? roc_00 : my_sector_idx == 1 ? roc_01 : my_sector_idx == 2 ? roc_02 :
     my_sector_idx == 3 ? roc_03 : my_sector_idx == 4 ? roc_04 : my_sector_idx == 5 ? roc_05 :
     my_sector_idx == 6 ? roc_06 : my_sector_idx == 7 ? roc_07 : my_sector_idx == 8 ? roc_08 :
     my_sector_idx == 9 ? roc_09 : my_sector_idx == 10 ? roc_10 : my_sector_idx == 11 ? roc_11 :
     my_sector_idx == 12 ? roc_12 : my_sector_idx == 13 ? roc_13 : my_sector_idx == 14 ? roc_14 :
     my_sector_idx == 15 ? roc_15 : my_sector_idx == 16 ? roc_16 : my_sector_idx == 17 ? roc_17 :
     my_sector_idx == 18 ? roc_18 : 0.0

// Build sorted array for ranking
rocs = array.new<float>(0)
array.push(rocs, roc_00), array.push(rocs, roc_01), array.push(rocs, roc_02)
array.push(rocs, roc_03), array.push(rocs, roc_04), array.push(rocs, roc_05)
array.push(rocs, roc_06), array.push(rocs, roc_07), array.push(rocs, roc_08)
array.push(rocs, roc_09), array.push(rocs, roc_10), array.push(rocs, roc_11)
array.push(rocs, roc_12), array.push(rocs, roc_13), array.push(rocs, roc_14)
array.push(rocs, roc_15), array.push(rocs, roc_16), array.push(rocs, roc_17)
array.push(rocs, roc_18)
array.sort(rocs, order.descending)

float rank_top = array.get(rocs, topN - 1)
float rank_bot = array.get(rocs, 19 - botN)

// FIX #4: rank tiebreaker — count how many sectors strictly beat my_roc, so
// identical ROC values (e.g. clustered 0.0% at session open) get a stable rank.
int better_count = 0
for i = 0 to 18
    if array.get(rocs, i) > my_roc
        better_count += 1
int my_rank = better_count + 1

bool is_top = my_rank <= topN
bool is_bot = my_rank >= (19 - botN + 1)

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 6 — STOCK vs SECTOR RELATIVE STRENGTH (Alpha Detection)
//   FIX #2: stock day-open also anchored to true "D" open
// ══════════════════════════════════════════════════════════════════════════════

float stock_day_open = request.security(syminfo.tickerid, "D", open, lookahead=barmerge.lookahead_off)
float stock_roc = stock_day_open != 0 ? (close - stock_day_open) / stock_day_open * 100.0 : 0.0

float rel_strength = stock_roc - my_roc

bool is_alpha_long  = rel_strength >= 0.3
bool is_alpha_short = rel_strength <= -0.3

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 7 — SMART MONEY / INSTITUTIONAL DETECTION
// ══════════════════════════════════════════════════════════════════════════════

mfi_val = ta.mfi(hlc3, 14)
bool mfi_bullish = mfi_val > 60
bool mfi_bearish = mfi_val < 40

cmf_mfv    = (high - low) != 0 ? ((close - low) - (high - close)) / (high - low) * volume : 0.0
cmf_val    = math.sum(cmf_mfv, 20) / math.max(math.sum(volume, 20), 1)
bool cmf_bullish = cmf_val > 0.05
bool cmf_bearish = cmf_val < -0.05

obv_val = ta.obv
obv_sma = ta.sma(obv_val, 20)
bool obv_bullish = obv_val > obv_sma and obv_val > obv_val[5]
bool obv_bearish = obv_val < obv_sma and obv_val < obv_val[5]

int smart_money_bull = (mfi_bullish ? 1 : 0) + (cmf_bullish ? 1 : 0) + (obv_bullish ? 1 : 0)
int smart_money_bear = (mfi_bearish ? 1 : 0) + (cmf_bearish ? 1 : 0) + (obv_bearish ? 1 : 0)

bool institutional_buying  = smart_money_bull >= 2
bool institutional_selling = smart_money_bear >= 2

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 8 — MOMENTUM CONFLUENCE
// ══════════════════════════════════════════════════════════════════════════════

rsi_main = ta.rsi(close, 14)
bool rsi_bull_zone = rsi_main > 50 and rsi_main < 75
bool rsi_bear_zone = rsi_main < 50 and rsi_main > 25

[macd_line, signal_line, hist] = ta.macd(close, 12, 26, 9)
bool macd_bull = macd_line > signal_line and hist > hist[1]
bool macd_bear = macd_line < signal_line and hist < hist[1]

stoch_k = ta.stoch(close, high, low, 14)
stoch_d = ta.sma(stoch_k, 3)
bool stoch_bull = stoch_k > stoch_d and stoch_k > 20 and stoch_k < 80
bool stoch_bear = stoch_k < stoch_d and stoch_k > 20 and stoch_k < 80

roc_5  = ta.roc(close, 5)
roc_10_mom = ta.roc(close, 10)
bool roc_accelerating_up = roc_5 > 0 and roc_5 > roc_10_mom
bool roc_accelerating_dn = roc_5 < 0 and roc_5 < roc_10_mom

int momentum_bull = (rsi_bull_zone ? 1 : 0) + (macd_bull ? 1 : 0) + (stoch_bull ? 1 : 0) + (roc_accelerating_up ? 1 : 0)
int momentum_bear = (rsi_bear_zone ? 1 : 0) + (macd_bear ? 1 : 0) + (stoch_bear ? 1 : 0) + (roc_accelerating_dn ? 1 : 0)

bool momentum_aligned_bull = momentum_bull >= 3
bool momentum_aligned_bear = momentum_bear >= 3

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 9 — PRICE ACTION QUALITY
// ══════════════════════════════════════════════════════════════════════════════

[di_p, di_m, adx_trend] = ta.dmi(14, 14)
bool strong_trend = adx_trend > 25

price_change = math.abs(close - close[10])
volatility_sum = math.sum(math.abs(close - close[1]), 10)
efficiency_ratio = volatility_sum != 0 ? price_change / volatility_sum : 0
bool clean_move = efficiency_ratio > 0.4

_hi3 = ta.highest(high[1], 3)
_lo3 = ta.lowest(low[1], 3)
bool hh_hl = high > _hi3 and low > _lo3
bool lh_ll = high < _hi3 and low < _lo3

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 9B — VWAP ANCHORED BANDS
// ══════════════════════════════════════════════════════════════════════════════

vwap_src   = hlc3
vwap_val   = ta.vwap(vwap_src)
vwap_stdev = ta.stdev(vwap_src, 20)

vwap_u1 = vwap_val + vwap_mult1 * vwap_stdev
vwap_l1 = vwap_val - vwap_mult1 * vwap_stdev
vwap_u2 = vwap_val + vwap_mult2 * vwap_stdev
vwap_l2 = vwap_val - vwap_mult2 * vwap_stdev

bool above_vwap    = close > vwap_val
bool near_vwap_sup = close > vwap_l1 and close < vwap_val
bool near_vwap_res = close < vwap_u1 and close > vwap_val
bool vwap_breakout_up = close > vwap_u1
bool vwap_breakout_dn = close < vwap_l1

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 9C — OPENING RANGE BREAKOUT (ORB)
// ══════════════════════════════════════════════════════════════════════════════

float vol_sma_sig = ta.sma(volume, vol_sma_len)
float vol_z       = f_zscore(volume, 20)

is_new_day = ta.change(time("D")) != 0
in_orb     = not na(time(timeframe.period, orb_sess))

var float orb_high = na
var float orb_low  = na

if is_new_day
    orb_high := na
    orb_low  := na

if in_orb
    orb_high := na(orb_high) ? high : math.max(orb_high, high)
    orb_low  := na(orb_low)  ? low  : math.min(orb_low,  low)

orb_formed     = not na(orb_high) and not in_orb
orb_range      = orb_formed ? orb_high - orb_low : na
bool orb_bull  = orb_formed and close > orb_high and vol_z > 1.5
bool orb_bear  = orb_formed and close < orb_low  and vol_z > 1.5

orb_target_up  = orb_formed ? orb_high + orb_range : na
orb_target_dn  = orb_formed ? orb_low  - orb_range : na

// FIX #3: session-settle gate — count bars since session open
int bars_since_open = ta.barssince(is_new_day)
bool session_settled = bars_since_open >= settle_bars

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 9D — DIVERGENCE DETECTION (RSI & MACD)
// ══════════════════════════════════════════════════════════════════════════════

_ph = ta.pivothigh(high, div_len, div_len)
_pl = ta.pivotlow(low,   div_len, div_len)

rsi_div = ta.rsi(close, 14)

ph_price_now  = not na(_ph)
ph_price_prev = ta.valuewhen(not na(_ph), high[div_len], 1)
ph_rsi_now    = ta.valuewhen(not na(_ph), rsi_div[div_len], 0)
ph_rsi_prev   = ta.valuewhen(not na(_ph), rsi_div[div_len], 1)
bool bear_div = ph_price_now and high[div_len] > ph_price_prev and ph_rsi_now < ph_rsi_prev

pl_price_now  = not na(_pl)
pl_price_prev = ta.valuewhen(not na(_pl), low[div_len], 1)
pl_rsi_now    = ta.valuewhen(not na(_pl), rsi_div[div_len], 0)
pl_rsi_prev   = ta.valuewhen(not na(_pl), rsi_div[div_len], 1)
bool bull_div = pl_price_now and low[div_len] < pl_price_prev and pl_rsi_now > pl_rsi_prev

bool hidden_bull_div = pl_price_now and low[div_len] > pl_price_prev and pl_rsi_now < pl_rsi_prev
bool hidden_bear_div = ph_price_now and high[div_len] < ph_price_prev and ph_rsi_now > ph_rsi_prev

var bool div_bull_active = false
var bool div_bear_active = false
var bool div_hbull_active = false
var bool div_hbear_active = false

if bull_div
    div_bull_active  := true
if bear_div
    div_bear_active  := true
if hidden_bull_div
    div_hbull_active := true
if hidden_bear_div
    div_hbear_active := true

if ta.barssince(bull_div)        > 5
    div_bull_active  := false
if ta.barssince(bear_div)        > 5
    div_bear_active  := false
if ta.barssince(hidden_bull_div) > 5
    div_hbull_active := false
if ta.barssince(hidden_bear_div) > 5
    div_hbear_active := false

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 9E — VOLUME PROFILE PROXY (Point of Control)
//   FIX #1: ta.highestbars() gives exact offset of highest-volume bar.
//   No float equality, no loop, no stale var.
// ══════════════════════════════════════════════════════════════════════════════

vol_lookback_poc = 20
int poc_bars_back = math.abs(ta.highestbars(volume, vol_lookback_poc))
float poc_price = (high[poc_bars_back] + low[poc_bars_back]) / 2.0

bool near_poc  = not na(poc_price) and math.abs(close - poc_price) / poc_price < 0.003
bool above_poc = not na(poc_price) and close > poc_price
bool below_poc = not na(poc_price) and close < poc_price

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 10 — PERFECT STOCK SCORE (0-100)
// ══════════════════════════════════════════════════════════════════════════════

float w_sector_rank  = 20.0
float w_alpha        = 15.0
float w_smart_money  = 15.0
float w_momentum     = 15.0
float w_price_action = 10.0
float w_orb          = 10.0
float w_divergence   = 10.0
float w_vwap         = 5.0

float score_buy = 0.0
score_buy += is_top ? w_sector_rank : 0
score_buy += is_alpha_long ? w_alpha : (rel_strength > 0 ? w_alpha/2 : 0)
score_buy += institutional_buying ? w_smart_money : (smart_money_bull >= 1 ? w_smart_money/2 : 0)
score_buy += momentum_aligned_bull ? w_momentum : (momentum_bull >= 2 ? w_momentum/2 : 0)
score_buy += (clean_move and hh_hl) ? w_price_action : (clean_move or hh_hl ? w_price_action/2 : 0)
score_buy += (use_orb and orb_bull) ? w_orb : 0
score_buy += use_div and (div_bull_active or div_hbull_active) ? w_divergence : 0
score_buy += above_vwap ? w_vwap : (near_vwap_sup ? w_vwap/2 : 0)

float score_sell = 0.0
score_sell += is_bot ? w_sector_rank : 0
score_sell += is_alpha_short ? w_alpha : (rel_strength < 0 ? w_alpha/2 : 0)
score_sell += institutional_selling ? w_smart_money : (smart_money_bear >= 1 ? w_smart_money/2 : 0)
score_sell += momentum_aligned_bear ? w_momentum : (momentum_bear >= 2 ? w_momentum/2 : 0)
score_sell += (clean_move and lh_ll) ? w_price_action : (clean_move or lh_ll ? w_price_action/2 : 0)
score_sell += (use_orb and orb_bear) ? w_orb : 0
score_sell += use_div and (div_bear_active or div_hbear_active) ? w_divergence : 0
score_sell += not above_vwap ? w_vwap : (near_vwap_res ? w_vwap/2 : 0)

float perfect_threshold = 70.0
float good_threshold    = 50.0

bool is_perfect_buy  = score_buy  >= perfect_threshold
bool is_perfect_sell = score_sell >= perfect_threshold

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 11 — GLOBAL SAFETY FILTERS
// ══════════════════════════════════════════════════════════════════════════════

bool  vol_confirmed = volume >= (vol_sma_sig * vol_sma_mult) and vol_z >= vol_z_thresh
bool  vol_too_high  = volume > vol_cap * ta.sma(volume, 100)

float atr_val       = ta.atr(14)
float candle_range  = high - low
float body_size     = math.abs(close - open)
float body_ratio    = candle_range != 0 ? body_size / candle_range : 0
bool  quality_ok    = body_ratio >= min_body
bool  is_exhaustion = candle_range > (max_body_atr * atr_val)

float htf_ema      = request.security(syminfo.tickerid, htf_tf, ta.ema(close, 200), lookahead=barmerge.lookahead_off)
bool  htf_buy_ok   = not use_htf or close > htf_ema
bool  htf_sell_ok  = not use_htf or close < htf_ema

[st_line, st_dir]  = ta.supertrend(st_factor, st_atr_len)
bool  is_uptrend   = st_dir < 0
bool  st_buy_ok    = not use_st or is_uptrend
bool  st_sell_ok   = not use_st or not is_uptrend

bool safety_passed = not is_exhaustion and not vol_too_high and quality_ok

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 12 — ENGINE 1: ADX + SECTOR RANK + ALPHA
// ══════════════════════════════════════════════════════════════════════════════

[diplus, diminus, adxVal] = ta.dmi(adx_len, adx_len)
bool strong_adx = adxVal > adx_thresh
bool price_up   = close > close[lookback]
bool price_down = close < close[lookback]

bool eng1_buy  = price_up   and diplus > diminus and strong_adx and vol_confirmed and is_top and is_alpha_long
bool eng1_sell = price_down and diminus > diplus and strong_adx and vol_confirmed and is_bot and is_alpha_short

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 13 — ENGINE 2: 15-INDICATOR AI MATRIX
// ══════════════════════════════════════════════════════════════════════════════

w_RSI  = 1.3, w_MACD = 1.6, w_Stoch = 1.0, w_MA  = 1.8, w_ADX_w = 1.5
w_BB   = 1.4, w_ROC  = 1.2, w_OBV   = 1.6, w_CCI = 1.1, w_WWL   = 1.0
w_EMA  = 1.7, w_VWAP = 1.5, w_ATR_w = 1.4, w_Vol = 2.0, w_Mom   = 1.9

_v_avg    = ta.sma(volume, 20)
_v_std    = ta.stdev(volume, 20)
_v_score  = math.max(0.0, math.min(100.0, 50 + (((volume - _v_avg) / math.max(_v_std, 1e-6)) * 15)))
_mom_s    = math.max(0.0, math.min(100.0, 50 + (ta.roc(close, 10) * 2)))
_ma_s     = close > ta.sma(close, 20) ? 80.0 : 20.0
_ema_s    = close > ta.ema(close, 21) ? 80.0 : 20.0
_vwap_s   = close > ta.vwap ? 80.0 : 20.0
[_dp, _dm, _adx2] = ta.dmi(14, 14)
_adx_s    = _adx2 > 25 and _dp > _dm ? 80.0 : 20.0
_rsi      = ta.rsi(close, 14)
_cci_s    = math.max(0.0, math.min(100.0, (ta.cci(close, 20) + 100.0) / 2.0))
_roc_s    = math.max(0.0, math.min(100.0, 50 + (ta.roc(close, 12) * 2)))
_st_val   = ta.stoch(close, high, low, 14)
[_m, _s, _h2] = ta.macd(close, 12, 26, 9)
_macd_s   = 50 + math.max(-25.0, math.min(25.0, (_m - _s) / math.max(close, 1e-6) * 1000))
_wwl_s    = 100.0 + ta.wpr(14)
_atr2     = ta.atr(14)
_atr_s    = _atr2 > ta.atr(40) ? 70.0 : 50.0
_obv_s    = math.max(0.0, math.min(100.0, 50 + ta.roc(ta.obv, 5)))
_bb_upper = ta.sma(close, 20) + 2 * ta.stdev(close, 20)
_bb_s     = close > _bb_upper ? 80.0 : 50.0

_tw = w_RSI + w_MACD + w_Stoch + w_MA + w_ADX_w + w_BB + w_ROC + w_OBV + w_CCI + w_WWL + w_EMA + w_VWAP + w_ATR_w + w_Vol + w_Mom
_sum = (_rsi*w_RSI + _macd_s*w_MACD + _st_val*w_Stoch + _ma_s*w_MA + _adx_s*w_ADX_w +
     _bb_s*w_BB + _roc_s*w_ROC + _obv_s*w_OBV + _cci_s*w_CCI + _wwl_s*w_WWL +
     _ema_s*w_EMA + _vwap_s*w_VWAP + _atr_s*w_ATR_w + _v_score*w_Vol + _mom_s*w_Mom)

float ai_score = _sum / _tw

bool eng2_buy  = ai_score >= 65
bool eng2_sell = ai_score <= 35

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 14 — ENGINE 3: SMART MONEY + MOMENTUM CONFLUENCE
// ══════════════════════════════════════════════════════════════════════════════

bool eng3_buy  = institutional_buying and momentum_aligned_bull
bool eng3_sell = institutional_selling and momentum_aligned_bear

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 15 — ENGINE 4: SUPERTREND + EMA + VWAP + CLEAN STRUCTURE
// ══════════════════════════════════════════════════════════════════════════════

bool ema_bull  = ta.ema(close, 9) > ta.ema(close, 21)
bool eng4_buy  = is_uptrend and ema_bull and close > ta.vwap and clean_move
bool eng4_sell = not is_uptrend and not ema_bull and close < ta.vwap and clean_move

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 16 — ENGINE 5: 8-DAY BREAKOUT + STRUCTURE
// ══════════════════════════════════════════════════════════════════════════════

float hi_brk = ta.highest(high, breakout_len)[1]
float lo_brk = ta.lowest(low, breakout_len)[1]

bool eng5_buy  = close > hi_brk and vol_z > 1.2 and hh_hl
bool eng5_sell = close < lo_brk and vol_z > 1.2 and lh_ll

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 16B — ENGINE 6: ORB + DIVERGENCE + VWAP CONFLUENCE
// ══════════════════════════════════════════════════════════════════════════════

bool eng6_buy  = (use_orb ? orb_bull : true) and
     (use_div ? (div_bull_active or div_hbull_active) : true) and
     above_poc and above_vwap

bool eng6_sell = (use_orb ? orb_bear : true) and
     (use_div ? (div_bear_active or div_hbear_active) : true) and
     below_poc and not above_vwap

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 17 — MASTER VOTING & PERFECT STOCK DETECTION
//   FIX #3: all final signals now also require session_settled
// ══════════════════════════════════════════════════════════════════════════════

int buy_votes  = (eng1_buy  ? 1 : 0) + (eng2_buy  ? 1 : 0) + (eng3_buy  ? 1 : 0) +
     (eng4_buy  ? 1 : 0) + (eng5_buy  ? 1 : 0) + (eng6_buy  ? 1 : 0)
int sell_votes = (eng1_sell ? 1 : 0) + (eng2_sell ? 1 : 0) + (eng3_sell ? 1 : 0) +
     (eng4_sell ? 1 : 0) + (eng5_sell ? 1 : 0) + (eng6_sell ? 1 : 0)

bool masterBuy  = buy_votes  >= min_votes and safety_passed and htf_buy_ok  and st_buy_ok  and is_top and session_settled and barstate.isconfirmed
bool masterSell = sell_votes >= min_votes and safety_passed and htf_sell_ok and st_sell_ok and is_bot and session_settled and barstate.isconfirmed

bool perfectBuy  = is_perfect_buy  and is_top and buy_votes  >= min_votes and safety_passed and htf_buy_ok  and st_buy_ok  and session_settled and barstate.isconfirmed
bool perfectSell = is_perfect_sell and is_bot and sell_votes >= min_votes and safety_passed and htf_sell_ok and st_sell_ok and session_settled and barstate.isconfirmed

bool is_good_buy  = score_buy  >= good_threshold and score_buy  < perfect_threshold and is_top
bool is_good_sell = score_sell >= good_threshold and score_sell < perfect_threshold and is_bot
string signal_type_buy  = perfectBuy  ? "PERFECT" : masterBuy  ? "STRONG" : is_good_buy  and buy_votes  >= 2 ? "GOOD" : "NONE"
string signal_type_sell = perfectSell ? "PERFECT" : masterSell ? "STRONG" : is_good_sell and sell_votes >= 2 ? "GOOD" : "NONE"

bool finalBuy  = perfectBuy or masterBuy
bool finalSell = perfectSell or masterSell

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 18 — VISUALS
// ══════════════════════════════════════════════════════════════════════════════

plot(st_line, "SuperTrend", color=is_uptrend ? color.green : color.red, linewidth=2)
plot(use_htf ? htf_ema : na, "HTF EMA 200", color=color.new(color.gray, 50), style=plot.style_linebr)

plot(vwap_val,  "VWAP",     color=color.new(color.blue, 30),   linewidth=1)
plot(show_vwap_bands ? vwap_u1 : na, "VWAP +1σ", color=color.new(color.teal, 50),  linewidth=1, style=plot.style_linebr)
plot(show_vwap_bands ? vwap_l1 : na, "VWAP -1σ", color=color.new(color.teal, 50),  linewidth=1, style=plot.style_linebr)
plot(show_vwap_bands ? vwap_u2 : na, "VWAP +2σ", color=color.new(color.purple, 60),linewidth=1, style=plot.style_linebr)
plot(show_vwap_bands ? vwap_l2 : na, "VWAP -2σ", color=color.new(color.purple, 60),linewidth=1, style=plot.style_linebr)

plot(orb_formed ? orb_high : na, "ORB High", color=color.new(color.orange, 30), linewidth=1, style=plot.style_linebr)
plot(orb_formed ? orb_low  : na, "ORB Low",  color=color.new(color.orange, 30), linewidth=1, style=plot.style_linebr)

plot(not na(poc_price) ? poc_price : na, "Vol POC", color=color.new(color.yellow, 40), linewidth=1, style=plot.style_circles)

plotshape(use_div and bull_div,        title="Bull Div",        style=shape.triangleup,   location=location.belowbar, color=color.new(color.aqua, 20),   size=size.tiny)
plotshape(use_div and bear_div,        title="Bear Div",        style=shape.triangledown, location=location.abovebar, color=color.new(color.orange, 20), size=size.tiny)
plotshape(use_div and hidden_bull_div, title="Hidden Bull Div", style=shape.triangleup,   location=location.belowbar, color=color.new(color.lime, 40),   size=size.tiny)
plotshape(use_div and hidden_bear_div, title="Hidden Bear Div", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 40),    size=size.tiny)

bgcolor(perfectBuy  ? color.new(color.lime, 70) : masterBuy  ? color.new(color.green, 85) : na, title="BUY Background")
bgcolor(perfectSell ? color.new(color.fuchsia, 70) : masterSell ? color.new(color.red, 85) : na, title="SELL Background")

barcolor(perfectBuy ? color.lime : perfectSell ? color.fuchsia : masterBuy ? color.green : masterSell ? color.red : na)

plotshape(perfectBuy,  title="PERFECT BUY",  style=shape.labelup,   location=location.belowbar, color=color.new(color.lime, 0), size=size.large, text="💎")
plotshape(perfectSell, title="PERFECT SELL", style=shape.labeldown, location=location.abovebar, color=color.new(color.fuchsia, 0), size=size.large, text="💎")
plotshape(masterBuy and not perfectBuy,  title="STRONG BUY",  style=shape.triangleup,   location=location.belowbar, color=color.new(color.green, 0), size=size.normal)
plotshape(masterSell and not perfectSell, title="STRONG SELL", style=shape.triangledown, location=location.abovebar, color=color.new(color.red, 0), size=size.normal)

if perfectBuy
    float sl_buy  = close - rr_atr_sl * atr_val
    float tgt_buy = close + rr_atr_sl * atr_val * rr_ratio
    label.new(bar_index, low,
         "💎 PERFECT BUY\n" +
         "Score: " + str.tostring(math.round(score_buy, 0)) + "/100\n" +
         "Votes: " + str.tostring(buy_votes) + "/6\n" +
         "Alpha: +" + str.tostring(math.round(rel_strength, 2)) + "%\n" +
         "Rank: #" + str.tostring(my_rank) + " 🔥\n" +
         "SL:  ₹" + str.tostring(sl_buy,  "#.##") + "\n" +
         "TGT: ₹" + str.tostring(tgt_buy, "#.##") + "\n" +
         sector_name,
         style=label.style_label_up, color=color.new(color.lime, 0),
         textcolor=color.black, size=size.normal)

if perfectSell
    float sl_sell  = close + rr_atr_sl * atr_val
    float tgt_sell = close - rr_atr_sl * atr_val * rr_ratio
    label.new(bar_index, high,
         "💎 PERFECT SELL\n" +
         "Score: " + str.tostring(math.round(score_sell, 0)) + "/100\n" +
         "Votes: " + str.tostring(sell_votes) + "/6\n" +
         "Alpha: " + str.tostring(math.round(rel_strength, 2)) + "%\n" +
         "Rank: #" + str.tostring(my_rank) + " 💀\n" +
         "SL:  ₹" + str.tostring(sl_sell,  "#.##") + "\n" +
         "TGT: ₹" + str.tostring(tgt_sell, "#.##") + "\n" +
         sector_name,
         style=label.style_label_down, color=color.new(color.fuchsia, 0),
         textcolor=color.white, size=size.normal)

if masterBuy and not perfectBuy
    float sl_buy2  = close - rr_atr_sl * atr_val
    float tgt_buy2 = close + rr_atr_sl * atr_val * rr_ratio
    label.new(bar_index, low,
         "🟢 STRONG BUY\n" +
         "Votes: " + str.tostring(buy_votes) + "/6\n" +
         "AI: " + str.tostring(math.round(ai_score, 1)) + "\n" +
         "SL:  ₹" + str.tostring(sl_buy2,  "#.##") + "\n" +
         "TGT: ₹" + str.tostring(tgt_buy2, "#.##") + "\n" +
         sector_name,
         style=label.style_label_up, color=color.new(color.green, 10),
         textcolor=color.white, size=size.small)

if masterSell and not perfectSell
    float sl_sell2  = close + rr_atr_sl * atr_val
    float tgt_sell2 = close - rr_atr_sl * atr_val * rr_ratio
    label.new(bar_index, high,
         "🔴 STRONG SELL\n" +
         "Votes: " + str.tostring(sell_votes) + "/6\n" +
         "AI: " + str.tostring(math.round(ai_score, 1)) + "\n" +
         "SL:  ₹" + str.tostring(sl_sell2,  "#.##") + "\n" +
         "TGT: ₹" + str.tostring(tgt_sell2, "#.##") + "\n" +
         sector_name,
         style=label.style_label_down, color=color.new(color.red, 10),
         textcolor=color.white, size=size.small)

plot(adxVal,  "ADX",  color=color.orange, display=display.pane)
plot(diplus,  "DI+",  color=color.green,  display=display.pane)
plot(diminus, "DI-",  color=color.red,    display=display.pane)
hline(adx_thresh, "ADX Threshold", color=color.gray, linestyle=hline.style_dashed)

plot(score_buy > score_sell ? score_buy : -score_sell, "Perfection Score",
     color=score_buy > score_sell ? color.lime : color.red, display=display.pane)
hline(70, "Perfect Threshold", color=color.yellow, linestyle=hline.style_dashed)
hline(-70, "Perfect Threshold", color=color.yellow, linestyle=hline.style_dashed)

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 19 — ALERTS
//   alert() fires ONLY on bar close (finalBuy/finalSell carry isconfirmed).
//   Set alert frequency to "Once Per Bar Close" in the TradingView dialog.
//   Vote strings corrected to /6 (FIX #5).
// ══════════════════════════════════════════════════════════════════════════════

int barHour = hour(time, "Asia/Kolkata")
int barMin  = minute(time, "Asia/Kolkata")
string barTime = str.tostring(barHour) + ":" + (barMin < 10 ? "0" : "") + str.tostring(barMin)

string alertMsg = perfectBuy ? (
     "💎 PERFECT BUY — " + syminfo.ticker + " [" + timeframe.period + "m]" +
     "\n⏰ Time       : " + barTime + " IST" +
     "\n📦 Sector     : " + sector_name +
     "\n🏆 Rank       : #" + str.tostring(my_rank) + " of 19 (TOP " + str.tostring(topN) + ")" +
     "\n💯 Score      : " + str.tostring(math.round(score_buy, 0)) + "/100 PERFECT" +
     "\n📈 Alpha      : +" + str.tostring(rel_strength, "#.##") + "% vs sector" +
     "\n🎯 Votes      : " + str.tostring(buy_votes) + "/6" +
     "\n🤖 AI Score   : " + str.tostring(ai_score, "#.##") +
     "\n💪 ADX        : " + str.tostring(adxVal, "#.##") +
     "\n🏦 Smart Money: " + str.tostring(smart_money_bull) + "/3 bullish" +
     "\n💰 Entry      : ₹" + str.tostring(close, "#.##")
     ) : perfectSell ? (
     "💎 PERFECT SELL — " + syminfo.ticker + " [" + timeframe.period + "m]" +
     "\n⏰ Time       : " + barTime + " IST" +
     "\n📦 Sector     : " + sector_name +
     "\n💀 Rank       : #" + str.tostring(my_rank) + " of 19 (BOT " + str.tostring(botN) + ")" +
     "\n💯 Score      : " + str.tostring(math.round(score_sell, 0)) + "/100 PERFECT" +
     "\n📉 Alpha      : " + str.tostring(rel_strength, "#.##") + "% vs sector" +
     "\n🎯 Votes      : " + str.tostring(sell_votes) + "/6" +
     "\n🤖 AI Score   : " + str.tostring(ai_score, "#.##") +
     "\n💪 ADX        : " + str.tostring(adxVal, "#.##") +
     "\n🏦 Smart Money: " + str.tostring(smart_money_bear) + "/3 bearish" +
     "\n💰 Entry      : ₹" + str.tostring(close, "#.##")
     ) : masterBuy ? (
     "🟢 STRONG BUY — " + syminfo.ticker + " [" + timeframe.period + "m]" +
     "\n⏰ Time       : " + barTime + " IST" +
     "\n📦 Sector     : " + sector_name +
     "\n🏆 Rank       : #" + str.tostring(my_rank) + " of 19" +
     "\n💯 Score      : " + str.tostring(math.round(score_buy, 0)) + "/100" +
     "\n🎯 Votes      : " + str.tostring(buy_votes) + "/6" +
     "\n💰 Entry      : ₹" + str.tostring(close, "#.##")
     ) : masterSell ? (
     "🔴 STRONG SELL — " + syminfo.ticker + " [" + timeframe.period + "m]" +
     "\n⏰ Time       : " + barTime + " IST" +
     "\n📦 Sector     : " + sector_name +
     "\n💀 Rank       : #" + str.tostring(my_rank) + " of 19" +
     "\n💯 Score      : " + str.tostring(math.round(score_sell, 0)) + "/100" +
     "\n🎯 Votes      : " + str.tostring(sell_votes) + "/6" +
     "\n💰 Entry      : ₹" + str.tostring(close, "#.##")
     ) : ""

if (finalBuy or finalSell) and barstate.isconfirmed
    alert(alertMsg, alert.freq_once_per_bar_close)

alertcondition(perfectBuy,               "💎 PERFECT BUY",  "PERFECT BUY — all stars aligned")
alertcondition(perfectSell,              "💎 PERFECT SELL", "PERFECT SELL — all stars aligned")
alertcondition(masterBuy,                "🟢 STRONG BUY",   "STRONG BUY — sector in TOP ranks")
alertcondition(masterSell,               "🔴 STRONG SELL",  "STRONG SELL — sector in BOT ranks")
alertcondition(finalBuy or finalSell,    "ANY Signal",      "Signal triggered")

// ══════════════════════════════════════════════════════════════════════════════
// SECTION 20 — DASHBOARD
// ══════════════════════════════════════════════════════════════════════════════

table_pos = dashPos == "Top Right" ? position.top_right :
     dashPos == "Bottom Right" ? position.bottom_right :
     dashPos == "Top Left" ? position.top_left : position.bottom_left

var table dash = table.new(table_pos, 2, 17,
     bgcolor=color.new(color.black, 15), border_width=1, border_color=color.gray)

if barstate.islast and showDash
    table.cell(dash, 0, 0, "METRIC", bgcolor=color.new(color.navy, 20),
         text_color=color.white, text_formatting=text.format_bold)
    table.cell(dash, 1, 0, "VALUE", bgcolor=color.new(color.navy, 20),
         text_color=color.white, text_formatting=text.format_bold)

    float display_score = score_buy > score_sell ? score_buy : score_sell
    string score_label = display_score >= 70 ? "💎 PERFECT" : display_score >= 50 ? "✅ GOOD" : "⏳ WAIT"
    table.cell(dash, 0, 1, "💯 SCORE", text_color=color.white, text_formatting=text.format_bold)
    table.cell(dash, 1, 1, str.tostring(math.round(display_score, 0)) + "/100 " + score_label,
         text_color=display_score >= 70 ? color.lime : display_score >= 50 ? color.yellow : color.gray,
         bgcolor=display_score >= 70 ? color.new(color.lime, 60) : na,
         text_formatting=text.format_bold)

    table.cell(dash, 0, 2, "📦 Sector", text_color=color.gray)
    table.cell(dash, 1, 2, sector_name,
         text_color=str.contains(sector_name, "⚠️") ? color.orange : color.yellow,
         text_formatting=text.format_bold)

    table.cell(dash, 0, 3, "🏆 Rank", text_color=color.gray)
    table.cell(dash, 1, 3,
         "#" + str.tostring(my_rank) + "/19" +
         (is_top ? " 🔥TOP" : is_bot ? " 💀BOT" : ""),
         text_color=is_top ? color.lime : is_bot ? color.red : color.gray,
         bgcolor=is_top ? color.new(color.green, 60) : is_bot ? color.new(color.red, 60) : na)

    table.cell(dash, 0, 4, "⚡ Alpha", text_color=color.gray)
    table.cell(dash, 1, 4,
         (rel_strength >= 0 ? "+" : "") + str.tostring(rel_strength, "#.##") + "%" +
         (is_alpha_long ? " 🚀" : is_alpha_short ? " 📉" : ""),
         text_color=is_alpha_long ? color.lime : is_alpha_short ? color.red : color.gray)

    table.cell(dash, 0, 5, "🏦 Smart $", text_color=color.gray)
    table.cell(dash, 1, 5,
         "Bull:" + str.tostring(smart_money_bull) + " Bear:" + str.tostring(smart_money_bear) +
         (institutional_buying ? " 🟢" : institutional_selling ? " 🔴" : ""),
         text_color=institutional_buying ? color.lime : institutional_selling ? color.red : color.gray)

    table.cell(dash, 0, 6, "🎯 Momentum", text_color=color.gray)
    table.cell(dash, 1, 6,
         "Bull:" + str.tostring(momentum_bull) + "/4 Bear:" + str.tostring(momentum_bear) + "/4",
         text_color=momentum_aligned_bull ? color.lime : momentum_aligned_bear ? color.red : color.gray)

    table.cell(dash, 0, 7, "🤖 AI Score", text_color=color.gray)
    table.cell(dash, 1, 7, str.tostring(ai_score, "#.#"),
         text_color=ai_score >= 65 ? color.lime : ai_score <= 35 ? color.red : color.gray)

    table.cell(dash, 0, 8, "💪 ADX", text_color=color.gray)
    table.cell(dash, 1, 8,
         str.tostring(adxVal, "#.##") + (strong_adx ? " ✅" : " ❌"),
         text_color=strong_adx ? color.lime : color.red)

    table.cell(dash, 0, 9, "📊 Structure", text_color=color.gray)
    table.cell(dash, 1, 9,
         (clean_move ? "Clean " : "Choppy ") + (hh_hl ? "HH/HL" : lh_ll ? "LH/LL" : "—"),
         text_color=clean_move and (hh_hl or lh_ll) ? color.lime : color.gray)

    table.cell(dash, 0, 10, "🕘️ ORB", text_color=color.gray)
    table.cell(dash, 1, 10,
         not orb_formed ? "Forming..." :
         orb_bull ? "▲ BREAKOUT" : orb_bear ? "▼ BREAKDOWN" :
         "Range: ₹" + str.tostring(math.round(nz(orb_range), 1)),
         text_color=orb_bull ? color.lime : orb_bear ? color.red : color.gray)

    table.cell(dash, 0, 11, "🔀 Divergence", text_color=color.gray)
    table.cell(dash, 1, 11,
         div_bull_active ? "Bull Div 🟢" : div_hbull_active ? "Hidden Bull 🟢" :
         div_bear_active ? "Bear Div 🔴" : div_hbear_active ? "Hidden Bear 🔴" : "None",
         text_color=div_bull_active or div_hbull_active ? color.lime :
                    div_bear_active or div_hbear_active ? color.red : color.gray)

    table.cell(dash, 0, 12, "📏 VWAP", text_color=color.gray)
    table.cell(dash, 1, 12,
         vwap_breakout_up ? "▲ Above +1σ" : above_vwap ? "▲ Above VWAP" :
         vwap_breakout_dn ? "▼ Below -1σ" : "▼ Below VWAP",
         text_color=above_vwap ? color.lime : color.red)

    table.cell(dash, 0, 13, "📦 Vol / Safety", text_color=color.gray)
    table.cell(dash, 1, 13,
         "Z:" + str.tostring(vol_z, "#.#") + (vol_confirmed ? "✅ " : "❌ ") +
         (safety_passed ? "Safe✅" : "Block⛔"),
         text_color=vol_confirmed and safety_passed ? color.lime : color.red)

    table.cell(dash, 0, 14, "📐 Trend", text_color=color.gray)
    table.cell(dash, 1, 14,
         (close > htf_ema ? "HTF▲ " : "HTF▼ ") + (is_uptrend ? "ST▲" : "ST▼"),
         text_color=(close > htf_ema and is_uptrend) ? color.lime :
                    (close < htf_ema and not is_uptrend) ? color.red : color.gray)

    table.cell(dash, 0, 15, "🎯 Votes", text_color=color.gray)
    table.cell(dash, 1, 15,
         "B:" + str.tostring(buy_votes) + " S:" + str.tostring(sell_votes) + " /6" +
         (session_settled ? "" : " ⏳"),
         text_color=buy_votes >= min_votes ? color.lime : sell_votes >= min_votes ? color.red : color.gray)

    table.cell(dash, 0, 16, "🚦 SIGNAL", text_color=color.white, text_formatting=text.format_bold)
    table.cell(dash, 1, 16,
         perfectBuy  ? "💎 PERFECT BUY"  :
         perfectSell ? "💎 PERFECT SELL" :
         masterBuy   ? "🟢 STRONG BUY"   :
         masterSell  ? "🔴 STRONG SELL"  : "⏳ WAIT",
         text_color=perfectBuy or perfectSell ? color.white : masterBuy or masterSell ? color.white : color.gray,
         bgcolor=perfectBuy ? color.new(color.lime, 20) : perfectSell ? color.new(color.fuchsia, 20) :
                 masterBuy ? color.new(color.green, 30) : masterSell ? color.new(color.red, 30) : na,
         text_formatting=text.format_bold)

// ══════════════════════════════════════════════════════════════════════════════
// END OF SCRIPT — v2 Accuracy Patch
// request.security calls: 19 close + 19 daily-open + 1 HTF EMA = 39 (within 40)
// ══════════════════════════════════════════════════════════════════════════════
